{
  "name": "infinity-entre-amigos",
  "version": "0.9.6",
  "private": true,
  "description": "Infinity: compartilhamento de tela P2P em alta qualidade para amigos.",
  "main": "electron/main.cjs",
  "author": "Greg Preto",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-helper.ps1",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "build:web": "vite build",
    "build:common": "npm run build:icon && npm run typecheck && npm run build:web",
    "build:win": "npm run build:native && npm run build:common && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:mac": "npm run build:common && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build": "npm run build:win"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@trystero-p2p/mqtt": "^0.25.3",
    "@trystero-p2p/torrent": "^0.25.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "trystero": "^0.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gregpreto.tela",
    "productName": "Infinity",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vitorpbeirigo",
        "repo": "tela-entre-amigos"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "native/bin/TelaAudioCapture.exe",
          "to": "TelaAudioCapture.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Infinity-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Infinity-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "O Infinity precisa capturar o áudio do sistema para transmiti-lo aos participantes da sala.",
        "NSLocalNetworkUsageDescription": "O Infinity usa a rede local para criar conexões diretas e privadas entre os computadores dos seus amigos."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infinity"
    }
  }
}
